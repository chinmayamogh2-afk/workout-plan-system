# Copy to .env (git-ignored) and change EVERY value. Never commit the real file.
DB_USERNAME=workout_user
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
APP_ADMIN_PASSWORD=change-me-admin-password
APP_TRAINER_PASSWORD=change-me-trainer-password

# Image to run (Docker Hub namespace/name) and its version tag
APP_IMAGE=devopsproject/workout-plan-system
APP_VERSION=latest
APP_PORT=8080

// =============================================================
// Jenkinsfile.rollback – Automated Rollback & Recovery Pipeline
// Purpose: Revert to a previous image version if an active release is faulty.
// Stages: Checkout → Rollback Application → Verify Health
// =============================================================

pipeline {
    agent any

    parameters {
        string(name: 'TARGET_VERSION', defaultValue: '1.0.9',
               description: 'Image version tag to roll back to (e.g. 1.0.9). Leave blank to auto-detect previous version')
        string(name: 'DOCKER_NAMESPACE', defaultValue: 'chinmay206',
               description: 'Docker Hub namespace')
    }

    environment {
        APP_IMAGE      = "${params.DOCKER_NAMESPACE}/workout-plan-system"
        APP_PORT       = '8082'
        TARGET_VERSION = "${params.TARGET_VERSION ?: ''}"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 15, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git log --oneline -3'
            }
        }

        stage('Rollback Application') {
            steps {
                withCredentials([file(credentialsId: 'workout-deploy-env', variable: 'ENV_FILE')]) {
                    sh '''
                        set -eu
                        chmod +x scripts/rollback.sh scripts/deploy.sh
                        export APP_IMAGE="${APP_IMAGE}"
                        export APP_PORT="${APP_PORT}"
                        export ENV_FILE="${ENV_FILE}"
                        
                        ROLLBACK_VER="${TARGET_VERSION:-}"
                        if [ -z "${ROLLBACK_VER}" ]; then
                            if [ -f ".deploy/previous_version" ]; then
                                ROLLBACK_VER="$(cat .deploy/previous_version)"
                            elif [ -f "../workout-plan-system/.deploy/previous_version" ]; then
                                ROLLBACK_VER="$(cat ../workout-plan-system/.deploy/previous_version)"
                            elif [ -f "../workout-plan-system/.deploy/current_version" ]; then
                                ROLLBACK_VER="$(cat ../workout-plan-system/.deploy/current_version)"
                            else
                                ROLLBACK_VER="1.0.9"
                            fi
                        fi

                        echo "Executing rollback to version: ${APP_IMAGE}:${ROLLBACK_VER}"
                        ./scripts/rollback.sh "${ROLLBACK_VER}"
                    '''
                }
            }
        }

        stage('Verify Health') {
            steps {
                sh '''
                    set -eu
                    echo "Checking health endpoint on port ${APP_PORT}..."
                    curl -fsS "http://localhost:${APP_PORT}/actuator/health" | grep -q '"status":"UP"'
                    echo "Application is verified UP and healthy on port ${APP_PORT}!"
                    docker ps --filter "name=workout-app"
                '''
            }
        }
    }

    post {
        success {
            echo "Rollback completed successfully and application is healthy."
        }
        failure {
            echo "Rollback failed! Check docker logs and container status."
        }
    }
}
